<!DOCTYPE html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=edge">
<meta charset="utf-8">
<title>Barpeta Polytechnic - Exam Management System</title>
<HTA:APPLICATION ID="BPExam" APPLICATIONNAME="Barpeta Exam Management System" SINGLEINSTANCE="yes"
  BORDER="thin" CAPTION="yes" SYSMENU="yes" MAXIMIZEBUTTON="no" MINIMIZEBUTTON="yes" SCROLL="no" SELECTION="no" CONTEXTMENU="no">
<style>
  body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:#153a68;color:#fff;text-align:center;}
  h1{font-size:20px;margin:26px 10px 2px;letter-spacing:.03em;}
  h2{font-size:14px;font-weight:normal;margin:0 10px 18px;opacity:.9;}
  #st{font-size:13px;margin:0 16px 16px;min-height:34px;}
  button{font-size:13px;padding:6px 14px;margin:0 4px;border:1px solid #fff;background:#fff;color:#153a68;cursor:pointer;}
  .f{position:absolute;bottom:8px;left:0;right:0;font-size:11px;opacity:.75;}
</style>
<script language="javascript">
var PORT = 8765;
var APP_B64 = [
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
"",
""
].join("");
var SERVER_PS = [
"param([string]$Root,[int]$Port=8765)",
"$l = New-Object System.Net.HttpListener",
"$l.Prefixes.Add(\"http://localhost:$Port/\")",
"try { $l.Start() } catch { exit 1 }",
"$last = Get-Date",
"while ($true) {",
"  $t = $l.GetContextAsync()",
"  while (-not $t.Wait(3000)) {",
"    if (((Get-Date) - $last).TotalSeconds -gt 180) { $l.Stop(); exit 0 }",
"  }",
"  $c = $t.Result",
"  $last = Get-Date",
"  try {",
"    if ($c.Request.Url.AbsolutePath -eq '/__ping') {",
"      $bytes = [Text.Encoding]::UTF8.GetBytes('ok'); $c.Response.ContentType = 'text/plain'",
"    } else {",
"      $bytes = [IO.File]::ReadAllBytes((Join-Path $Root 'index.html')); $c.Response.ContentType = 'text/html; charset=utf-8'",
"    }",
"    $c.Response.ContentLength64 = $bytes.Length",
"    $c.Response.OutputStream.Write($bytes, 0, $bytes.Length)",
"  } catch {}",
"  try { $c.Response.OutputStream.Close() } catch {}",
"}",
""
].join("\r\n");

var sh = new ActiveXObject("WScript.Shell");
var fso = new ActiveXObject("Scripting.FileSystemObject");
var appDir = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\BarpetaExamSystem";
var appPath = null;

function setStatus(t){ document.getElementById("st").innerHTML = t; }

function writeApp(){
  if(!fso.FolderExists(appDir)) fso.CreateFolder(appDir);
  var path = appDir + "\\index.html";
  var xml = new ActiveXObject("MSXML2.DOMDocument");
  var el = xml.createElement("b");
  el.dataType = "bin.base64";
  el.text = APP_B64;
  var stm = new ActiveXObject("ADODB.Stream");
  stm.Type = 1; stm.Open();
  stm.Write(el.nodeTypedValue);
  stm.SaveToFile(path, 2);
  stm.Close();
  var ts = fso.CreateTextFile(appDir + "\\server.ps1", true, false);
  ts.Write(SERVER_PS); ts.Close();
  return path;
}

function findBrowser(){
  var bases = [sh.ExpandEnvironmentStrings("%ProgramFiles%"), sh.ExpandEnvironmentStrings("%ProgramFiles(x86)%"), sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")];
  var rel = ["\\Microsoft\\Edge\\Application\\msedge.exe", "\\Google\\Chrome\\Application\\chrome.exe"];
  for(var r = 0; r < rel.length; r++){
    for(var i = 0; i < bases.length; i++){
      var p = bases[i] + rel[r];
      if(fso.FileExists(p)) return p;
    }
  }
  return null;
}

function serverUp(){
  try{
    var x = new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");
    x.setTimeouts(500, 500, 800, 800);
    x.open("GET", "http://localhost:" + PORT + "/__ping", false);
    x.send();
    return x.status == 200;
  }catch(e){ return false; }
}

function startServer(){
  if(serverUp()) return true;
  sh.Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + appDir + '\\server.ps1" -Root "' + appDir + '" -Port ' + PORT, 0, false);
  for(var i = 0; i < 12; i++){
    var t = new Date().getTime(); while(new Date().getTime() - t < 400){}
    if(serverUp()) return true;
  }
  return false;
}

function launch(){
  try{
    appPath = writeApp();
    var url, note;
    if(startServer()){ url = "http://localhost:" + PORT + "/"; note = ""; }
    else { url = "file:///" + encodeURI(appPath.replace(/\\/g, "/")); note = "<br>(Google Drive sign-in is unavailable in this mode.)"; }
    var exe = findBrowser();
    if(exe){
      sh.Run('"' + exe + '" --app="' + url + '"', 1, false);
      setStatus("Opened in its own window." + note + "<br>You can close this launcher.");
      setTimeout(function(){ window.close(); }, 2500);
    } else {
      openDefault();
    }
  }catch(e){
    setStatus("Could not start: " + e.message);
  }
}
function openDefault(){
  try{
    if(!appPath) appPath = writeApp();
    var target = startServer() ? ("http://localhost:" + PORT + "/") : appPath;
    sh.Run('cmd /c start "" "' + target + '"', 0, false);
    setStatus("Opened in your default browser.");
  }catch(e){ setStatus("Could not start: " + e.message); }
}
window.onload = function(){
  try{ window.resizeTo(480, 280); window.moveTo((screen.width-480)/2, (screen.height-280)/3); }catch(e){}
  setStatus("Starting...");
  setTimeout(launch, 200);
};
</script>
</head>
<body>
  <h1>BARPETA POLYTECHNIC</h1>
  <h2>Exam Management System</h2>
  <div id="st"></div>
  <button onclick="launch()">Open again</button>
  <button onclick="openDefault()">Open in default browser</button>
  <div class="f">Developed by Ruhul Amin Laskar, Lecturer, Biomedical Engineering</div>
</body>
</html>
